# Papyrbound Server Configuration

PROJECT_NAME="Papyrbound API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite for immediate development, or PostgreSQL in production:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/papyrbound"
DATABASE_URL="sqlite+aiosqlite:///./papyrbound_server.db"

# Security & JWT Tokens
SECRET_KEY="papyrbound_dev_super_secret_jwt_key_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 (PKCE)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/v1/auth/google/callback"
DESKTOP_APP_DEEP_LINK="papyrbound://auth/callback"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","tauri://localhost","http://tauri.localhost"]
